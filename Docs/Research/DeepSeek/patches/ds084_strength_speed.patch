+		assert(!StrengthSpeedCapFor(JVec{0, 0, 10}, JVec{10, 0, 10}, 9.81f, 1.0f, true).valid);
+		assert(!StrengthSpeedCapFor(JVec{0, 0, 10}, JVec{3, 0, 10}, 9.81f, 1.0f, true).valid);
+		assert(!StrengthSpeedCapFor(JVec{0, 0, 10}, JVec{3, 0, 8}, 9.81f, 1.0f, true).valid);
+		assert(!StrengthSpeedCapFor(JVec{0, 0, 0}, JVec{1, 0, 20}, 9.81f, 1.0f, true).valid);
+	}
