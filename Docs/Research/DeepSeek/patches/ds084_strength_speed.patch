 // Pure logic, no engine types; Tests/BotJumpLinkTests.cpp.
 #pragma once
 #include <cmath>
+#include <algorithm>
 
 namespace WarsBots {
 
@@ -58,6 +59,39 @@ struct LinkParams {
 	float maxStrengthRise = 3.72f;     // DS-046: native Strength jump rise ~3.62 m; a +4.30 m link cannot land
 };
 
+// DS-084: native Strength jump v0 from the actual actor params (PlayerMovement.cpp:1130+: mult 4.7,
+// v0 = sqrt(2*g*jumpHeight*4.7) - 0.5*g*inAir). For a steep-short upward link whose needed horizontal speed is
+// inside the audited run band, cap the ground/air speed and disable sprint. Long/flat/drop links keep the legacy
+// sprint; invalid physics or missing suit energy gives no cap (the executor's rise/energy gates still apply).
+struct StrengthSpeedCap
+{
+	bool valid = false;
+	float needed = 0.f;   // horizontal m/s needed to reach b on the descending branch
+	float cap = 0.f;      // bounded desired speed for run-up/Act/Air
+};
+
+inline StrengthSpeedCap StrengthSpeedCapFor(const JVec& a, const JVec& b, float gravity, float jumpHeight,
+	bool energyOk, float airTime = 0.f)
+{
+	StrengthSpeedCap r;
+	if (!(gravity > 0.f) || !(jumpHeight > 0.f) || !energyOk) return r;
+	const float dz = b.z - a.z;
+	if (dz <= 0.5f) return r;                       // not a steep upward link (drop/flat/downward)
+	const float v0 = std::sqrt(2.f * gravity * jumpHeight * 4.7f) - 0.5f * gravity * std::max(0.f, airTime);
+	if (!(v0 > 0.f)) return r;
+	const float disc = v0 * v0 - 2.f * gravity * dz;
+	if (disc <= 0.f) return r;
+	const float t = (v0 + std::sqrt(disc)) / gravity;
+	const float dx = b.x - a.x, dy = b.y - a.y;
+	const float dist = std::sqrt(dx * dx + dy * dy);
+	if (!(t > 1e-3f) || !(dist > 0.05f)) return r;
+	r.needed = dist / t;
+	if (r.needed > 3.6f) return r;                  // too long to cap inside the audited clear band; legacy sprint
+	r.cap = std::min(4.0f, std::max(2.5f, r.needed * 1.1f));
+	r.valid = true;
+	return r;
+}
+
 class BotJumpLink {
 public:
 	explicit BotJumpLink(const LinkParams& p = LinkParams()) : m_p(p) {}
@@ -66,6 +100,11 @@ public:
 	LinkPhase Phase() const { return m_phase; }
 	LinkMove Move() const { return m_move; }
 	void Reset() { m_phase = LinkPhase::Idle; }
+	// DS-084: bounded speed for this link from the live actor params; invalid means "keep the legacy path".
+	StrengthSpeedCap SpeedCap(float gravity, float jumpHeight, bool energyOk, float airTime = 0.f) const
+	{
+		return StrengthSpeedCapFor(m_a, m_b, gravity, jumpHeight, energyOk, airTime);
+	}
 
 	void Start(float now, LinkMove move, const JVec& a, const JVec& b)
 	{
