+++ b/Code/CryGame/Bots/BotMovement.cpp
@@ -64,19 +64,23 @@ bool BotMovement::SafeStep(CActor& actor, const Vec3& direction, float probe, bo
 	// Three parallel body-width rays prevent a shoulder clipping a corner.
 	// P0 (C-055 stalls, X-049): on a Detour corner path the knee ray at 0.4 m hits stair risers 1-1.5 m ahead and
 	// declared the stairs a wall (level-4 traps on Steelmill stairs at z 142-144). The mesh already proved the slope/step.
+	bool bodyBlocked = false;
 	for (float side : {-0.3f,0.0f,0.3f})
 	for (float height : {0.4f,1.1f,1.6f})
-		if (!(meshGuided && height < 1.0f) && gEnv->pPhysicalWorld->RayWorldIntersection(feet + Vec3(-direction.y*side,direction.x*side,height), (direction + Vec3(0,0,slope)) * probe,
+		if (!bodyBlocked && !(meshGuided && height < 1.0f) && gEnv->pPhysicalWorld->RayWorldIntersection(feet + Vec3(-direction.y*side,direction.x*side,height), (direction + Vec3(0,0,slope)) * probe,
 			ent_all, flags, &hit, 1, actor.GetEntity()->GetPhysics(), heldPhysics))
-			return false;
-	// DS-070: in gated deep water the ground probe cannot hit (the seabed is far below); the stock movement
-	// controller owns buoyancy. Only this ray is skipped - the nine body/cliff rays above still refuse a wall,
-	// a quay or a held item, and a dry cliff keeps the old branch.
-	if (waterMovement) return true;
-	// Stop at real cliffs only: drops up to ~3 m are taken (Armor absorbs the landing, see BotBrain).
-	return gEnv->pPhysicalWorld->RayWorldIntersection(feet + direction * (probe-0.3f) + Vec3(0,0,0.6f),
-		Vec3(0,0,-3.6f), ent_terrain | ent_static | ent_rigid | ent_sleeping_rigid,
-		flags, &hit, 1, actor.GetEntity()->GetPhysics()) != 0;
+			{ bodyBlocked = true; break; }
+	// DS-070c: one decision table. Body/cliff rays above always win; gated deep water only relaxes the downward
+	// ground probe (the stock controller owns buoyancy); dry ground keeps the old "ground within reach" rule.
+	bool groundHit = false;
+	if (!bodyBlocked)
+	{
+		// Stop at real cliffs only: drops up to ~3 m are taken (Armor absorbs the landing, see BotBrain).
+		groundHit = gEnv->pPhysicalWorld->RayWorldIntersection(feet + direction * (probe-0.3f) + Vec3(0,0,0.6f),
+			Vec3(0,0,-3.6f), ent_terrain | ent_static | ent_rigid | ent_sleeping_rigid,
+			flags, &hit, 1, actor.GetEntity()->GetPhysics()) != 0;
+	}
+	return WaterStepAllowed(waterMovement, bodyBlocked, groundHit);
 }
 
