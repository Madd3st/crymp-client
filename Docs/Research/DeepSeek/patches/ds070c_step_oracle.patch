diff --git a/Code/CryGame/Bots/BotWaterPolicy.h b/Code/CryGame/Bots/BotWaterPolicy.h
index c7d9e90f..28300645 100644
--- a/Code/CryGame/Bots/BotWaterPolicy.h
+++ b/Code/CryGame/Bots/BotWaterPolicy.h
@@ -26,6 +26,14 @@ inline bool BotWaterAllowed(const BotWaterFacts& f)
 		f.captureEnabled && f.navMeshEnabled && f.hasNanoSuit;
 }
 
+// SafeStep decision: body/cliff rays always win; gated water does not need the downward ground ray; dry ground
+// keeps exactly the old "ground must be within reach" rule. Used by BotMovement::SafeStep, tested here.
+inline bool WaterStepAllowed(bool waterMovement, bool bodyBlocked, bool groundHit)
+{
+	if (bodyBlocked) return false;
+	return waterMovement ? true : groundHit;
+}
+
 // Engine-side facts for one actor. Defined in BotWaterPolicy.cpp; the pure truth table above links without it.
 BotWaterFacts BotWaterFactsFor(const CPlayer& actor);
 bool BotWaterAllowedFor(const CPlayer& actor);
diff --git a/Tests/BotWaterPolicyTests.cpp b/Tests/BotWaterPolicyTests.cpp
index f8643950..bfccd4d1 100644
--- a/Tests/BotWaterPolicyTests.cpp
+++ b/Tests/BotWaterPolicyTests.cpp
@@ -41,6 +41,15 @@ int main()
 	// The default struct (all false) can never enable water.
 	{ BotWaterFacts f; assert(!BotWaterAllowed(f)); }
 
+	// DS-070c SafeStep decision: dry void/cliff and water walls always block; dry ground keeps the ground rule;
+	// only gated deep water may skip the downward ray.
+	assert(!WaterStepAllowed(false, false, false)); // dry void / no ground
+	assert(!WaterStepAllowed(false, true, true));   // dry cliff/body hit with ground below
+	assert(WaterStepAllowed(false, false, true));   // dry land with ground
+	assert(!WaterStepAllowed(true, true, false));   // water wall/quay/held item
+	assert(WaterStepAllowed(true, false, false));   // gated deep water, ground out of reach
+	assert(WaterStepAllowed(true, false, true));    // gated deep water over shallow ground
+
 	std::puts("BotWaterPolicyTests OK");
 	return 0;
 }
