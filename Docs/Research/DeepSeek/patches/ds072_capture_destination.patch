+std::string LevelMissionXml()
+{
+	if (!g_pGame || !g_pGame->GetIGameFramework() || !gEnv->pCryPak) return {};
+	ILevel* level = g_pGame->GetIGameFramework()->GetILevelSystem()->GetCurrentLevel();
+	const ILevelInfo* info = level ? level->GetLevelInfo() : nullptr;
+	const char* path = info ? info->GetPath() : nullptr;
+	if (!path || !*path) return {};
+	std::string file = path;
+	if (file.back() != '/') file += '/';
+	file += "mission_mission0.xml";
+	FILE* f = gEnv->pCryPak->FOpen(file.c_str(), "rb");
+	if (!f) { WB_LOG(0, "[WarsBots] PS CAPTURE cannot open %s.", file.c_str()); return {}; }
+	const size_t size = gEnv->pCryPak->FGetSize(f);
+	std::string xml;
+	if (size)
+	{
+		xml.resize(size);
+		const size_t got = gEnv->pCryPak->FReadRawAll(&xml[0], size, f);
+		xml.resize(got);
+	}
+	gEnv->pCryPak->FClose(f);
+	return xml;
