+					if (Attr(areaTag, "Height", value)) s.height = float(atof(value.c_str()));
+					if (Attr(entityTag, "Pos", value)) sscanf(value.c_str(), "%f,%f,%f", &s.pos.x, &s.pos.y, &s.pos.z);
+					if (Attr(entityTag, "Rotate", value)) sscanf(value.c_str(), "%f,%f,%f,%f", &s.rot.v.x, &s.rot.v.y, &s.rot.v.z, &s.rot.w);
