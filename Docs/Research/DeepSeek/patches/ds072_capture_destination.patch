+					const size_t p0 = xml.find("<Points>", tagEnd);
+					const size_t p1 = p0 == std::string::npos ? p0 : xml.find("</Points>", p0);
+					if (p0 != std::string::npos && p1 != std::string::npos && (areaEnd == std::string::npos || p1 < areaEnd))
+					{
