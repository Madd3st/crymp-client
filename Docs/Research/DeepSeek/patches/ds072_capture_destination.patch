+			const size_t entityTagEnd = xml.find('>', entityStart);
+			if (entityTagEnd != std::string::npos && entityTagEnd < pos)
+			{
+				const std::string entityTag = xml.substr(entityStart, entityTagEnd - entityStart + 1);
+				std::string cls, value;
+				if (Attr(entityTag, "EntityClass", cls) && cls == "AreaShape" &&
+					Attr(entityTag, "EntityId", value))
+				{
