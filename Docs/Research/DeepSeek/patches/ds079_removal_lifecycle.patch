diff --git a/Code/CryGame/Bots/BotRemovalPolicy.h b/Code/CryGame/Bots/BotRemovalPolicy.h
new file mode 100644
index 00000000..65641e55
--- /dev/null
+++ b/Code/CryGame/Bots/BotRemovalPolicy.h
@@ -0,0 +1,27 @@
+// DS-079: classify an ENTITY_EVENT_DONE for a registered bot. Engine-free so explicit immediate/deferred removal,
+// a true external reset, level end and duplicate DONE are all testable without the engine.
+//
+// The Manager used to check only `Removing()` (true only while its own RemoveEntity call is on the stack). A deferred
+// explicit removal therefore looked external when DONE arrived later: it queued a roster restore and logged
+// "removed externally", later re-creating a bot the operator had removed. RemovalPending() carries the durable
+// intent, Expired() covers a duplicate DONE after OnEntityDone, and levelReady=false covers level teardown.
+#pragma once
+
+namespace WarsBots
+{
+enum class BotDoneAction
+{
+	Ignore = 0,
+	RestoreExternal,
+};
+
+// known: the entity id resolved to one of our registered bots; levelReady: the level is live;
+// removing: our RemoveEntity call is on the stack; removalPending: durable explicit-removal intent;
+// expired: OnEntityDone already processed this instance (duplicate DONE).
+inline BotDoneAction BotDoneDecision(bool known, bool levelReady, bool removing, bool removalPending, bool expired)
+{
+	if (!known || !levelReady) return BotDoneAction::Ignore;
+	if (removing || removalPending || expired) return BotDoneAction::Ignore;
+	return BotDoneAction::RestoreExternal;
+}
+}
diff --git a/Tests/BotRemovalPolicyTests.cpp b/Tests/BotRemovalPolicyTests.cpp
new file mode 100644
index 00000000..b1b3a3c0
--- /dev/null
+++ b/Tests/BotRemovalPolicyTests.cpp
@@ -0,0 +1,28 @@
+// DS-079 regression: explicit immediate/deferred removal must never be treated as an external reset, while a true
+// external deletion still restores, and level end / duplicate DONE / foreign entities stay ignored.
+#include "CryGame/Bots/BotRemovalPolicy.h"
+#include <cassert>
+#include <cstdio>
+
+using namespace WarsBots;
+
+int main()
+{
+	// Explicit immediate removal: DONE arrives inside our RemoveEntity call.
+	assert(BotDoneDecision(true, true, true, true, false) == BotDoneAction::Ignore);
+	// Explicit deferred removal (observed C145 bug): Removing() is already false, RemovalPending() is the durable truth.
+	assert(BotDoneDecision(true, true, false, true, false) == BotDoneAction::Ignore);
+	// True external deletion (native RestartGame/Reset): no explicit intent, level live -> restore the same bot.
+	assert(BotDoneDecision(true, true, false, false, false) == BotDoneAction::RestoreExternal);
+	// Level teardown: never queue a restore.
+	assert(BotDoneDecision(true, false, false, false, false) == BotDoneAction::Ignore);
+	// Duplicate DONE after OnEntityDone cleared the identity.
+	assert(BotDoneDecision(true, true, false, false, true) == BotDoneAction::Ignore);
+	// Deferred removal followed by a duplicate DONE stays ignored.
+	assert(BotDoneDecision(true, true, false, true, true) == BotDoneAction::Ignore);
+	// Foreign/unknown entity id never resolves to a registered bot.
+	assert(BotDoneDecision(false, true, false, false, false) == BotDoneAction::Ignore);
+
+	std::puts("BotRemovalPolicyTests OK");
+	return 0;
+}
