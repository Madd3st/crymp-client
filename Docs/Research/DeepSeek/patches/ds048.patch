diff --git a/Code/CryGame/Bots/BotPSCapture.cpp b/Code/CryGame/Bots/BotPSCapture.cpp
new file mode 100644
index 00000000..5eecddc7
--- /dev/null
+++ b/Code/CryGame/Bots/BotPSCapture.cpp
@@ -0,0 +1,71 @@
+// DS-048 #3: PS-1 capture goal data. Caches the capturable entities once per level (class, index, capture time,
+// position) and refreshes only their owner team, which changes during the match.
+#include "PortIncludes.h"
+#include "CryGame/Bots/BotPSCaptureRuntime.h"
+#include "CryGame/Bots/BotLog.h"
+#include "CryGame/Game.h"
+#include "CryGame/GameRules.h"
+#include "CryCommon/CryAction/ILevelSystem.h"
+#include "CryCommon/CryEntitySystem/IEntitySystem.h"
+#include "CryCommon/CryScriptSystem/IScriptSystem.h"
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace WarsBots {
+namespace {
+
+const std::vector<PsCapturePoint>& BasePoints()
+{
+	static std::string levelName;
+	static std::vector<PsCapturePoint> points;
+	if (!g_pGame || !g_pGame->GetIGameFramework()) return points;
+	ILevel* level = g_pGame->GetIGameFramework()->GetILevelSystem()->GetCurrentLevel();
+	const char* name = level && level->GetLevelInfo() ? level->GetLevelInfo()->GetName() : nullptr;
+	const std::string current = name ? name : "";
+	if (current == levelName && !points.empty()) return points;
+	levelName = current;
+	points.clear();
+	if (!gEnv || !gEnv->pEntitySystem) return points;
+
+	IEntityClass* energy = gEnv->pEntitySystem->GetClassRegistry()->FindClass("AlienEnergyPoint");
+	IEntityClass* factory = gEnv->pEntitySystem->GetClassRegistry()->FindClass("Factory");
+	IEntityItPtr it = gEnv->pEntitySystem->GetEntityIterator();
+	while (IEntity* entity = it->Next())
+	{
+		IEntityClass* cls = entity->GetClass();
+		const bool isEnergy = cls && cls == energy;
+		const bool isFactory = cls && cls == factory;
+		if (!isEnergy && !isFactory) continue;
+		IScriptTable* table = entity->GetScriptTable();
+		if (!table) continue;
+		SmartScriptTable props;
+		if (!table->GetValue("Properties", props)) continue;
+		int capturable = 0, index = 1;
+		float captureTime = 15.f;
+		props->GetValue("bCapturable", capturable);
+		if (!capturable) continue;
+		props->GetValue("nCaptureIndex", index);
+		props->GetValue("captureTime", captureTime);
+		const Vec3 pos = entity->GetWorldPos();
+		PsCapturePoint point;
+		point.id = int(entity->GetId());
+		point.value = index > 0 ? index : 1;
+		point.captureSeconds = int(captureTime);
+		point.power = isEnergy;
+		point.x = pos.x; point.y = pos.y; point.z = pos.z;
+		points.push_back(point);
+	}
+	WB_LOG(0, "[WarsBots] PS CAPTURE %d capturable points for %s.", int(points.size()), current.c_str());
+	return points;
+}
+
+} // namespace
+
+void PSCaptureSnapshot(std::vector<PsCapturePoint>& out, CGameRules& rules)
+{
+	out = BasePoints();
+	for (PsCapturePoint& point : out) point.ownerTeam = rules.GetTeam(EntityId(point.id));
+}
+
+} // namespace WarsBots
diff --git a/Code/CryGame/Bots/BotPSCapture.h b/Code/CryGame/Bots/BotPSCapture.h
new file mode 100644
index 00000000..9a201a2d
--- /dev/null
+++ b/Code/CryGame/Bots/BotPSCapture.h
@@ -0,0 +1,76 @@
+// DS-048 #3: PS-1 capture goal. Engine-free planner: pick the nearest capturable point that is not owned by the
+// bot's team, weighted by the point value (nCaptureIndex) and by power generation, then hold it until captured and
+// move to the next. The engine adapter (BotPSCapture.cpp) supplies the live owner teams; no engine includes here.
+#pragma once
+#include <cmath>
+
+namespace WarsBots {
+
+struct PsCapturePoint
+{
+    int id = 0;              // entity id (flag/factory/alien energy point)
+    int ownerTeam = 0;       // 0 = neutral
+    int value = 1;           // nCaptureIndex 1..3 (100/200/300 PP per DS-028)
+    int captureSeconds = 15; // informational
+    bool capturable = true;
+    bool power = false;      // AlienEnergyPoint: power is the first objective
+    float x = 0, y = 0, z = 0;
+};
+
+struct PsCapturePlan
+{
+    bool valid = false;
+    bool hold = false;       // already inside the capture radius
+    int id = 0;
+    float x = 0, y = 0, z = 0;
+};
+
+class BotPSCapture
+{
+public:
+    void Reset() { m_target = 0; }
+    int Target() const { return m_target; }
+
+    // Nearest point not owned by `team`; value/power bonus -8 m/-6 m. Keeps the current target while it is still
+    // capturable and not beaten by more than `switchMargin` metres (no oscillation between equal points).
+    PsCapturePlan Update(const PsCapturePoint* points, int count, int team, float bx, float by, float bz,
+                         float holdRadius = 6.f, float switchMargin = 15.f)
+    {
+        PsCapturePlan plan;
+        if (!points || count <= 0 || team == 0) { m_target = 0; return plan; }
+        int best = 0, current = 0;
+        float bestScore = 1e9f, bestDist = 0, currentScore = 1e9f, currentDist = 0;
+        for (int i = 0; i < count; ++i)
+        {
+            const PsCapturePoint& p = points[i];
+            if (!p.capturable || p.ownerTeam == team) continue;
+            const float dx = p.x - bx, dy = p.y - by, dz = p.z - bz;
+            const float d = std::sqrt(dx * dx + dy * dy + dz * dz);
+            const float score = d - 8.0f * float(p.value > 0 ? p.value : 1) - (p.power ? 6.0f : 0.0f);
+            if (p.id == m_target) { current = p.id; currentScore = score; currentDist = d; }
+            if (score < bestScore) { best = p.id; bestScore = score; bestDist = d; }
+        }
+        if (!best) { m_target = 0; return plan; }
+        // Hysteresis: keep a valid current target unless the alternative is clearly better.
+        if (current && best != current && currentScore <= bestScore + switchMargin)
+        {
+            best = current; bestScore = currentScore; bestDist = currentDist;
+        }
+        m_target = best;
+        for (int i = 0; i < count; ++i)
+        {
+            if (points[i].id != best) continue;
+            plan.valid = true;
+            plan.id = best;
+            plan.x = points[i].x; plan.y = points[i].y; plan.z = points[i].z;
+            plan.hold = bestDist <= holdRadius;
+            break;
+        }
+        return plan;
+    }
+
+private:
+    int m_target = 0;
+};
+
+} // namespace WarsBots
