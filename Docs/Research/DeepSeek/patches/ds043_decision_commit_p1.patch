diff --git a/Code/CryGame/Bots/BotDecisionCommit.h b/Code/CryGame/Bots/BotDecisionCommit.h
new file mode 100644
index 00000000..490d42fa
--- /dev/null
+++ b/Code/CryGame/Bots/BotDecisionCommit.h
@@ -0,0 +1,117 @@
+// Decision commitment gate (DS-034/DS-043 P1). Engine-free: only the state writer and the movement commit.
+// The bot writes its state from several places in one 10 Hz tick (roam, upgrade, combat, vantage). This gate accepts
+// at most one state change per decision serial, enforces a minimum dwell for non-urgent changes and makes conflicts
+// observable (STATE CONFLICT) instead of silent.
+//
+// pure C++17, no engine types; Tests/BotDecisionCommitTests.cpp.
+#pragma once
+#include <cstdint>
+
+namespace WarsBots {
+
+enum class DecisionOwner : uint8_t { Arbiter = 0, Upgrade, Roam, Combat, Look, Range, Finish, Count };
+enum class DecisionState : uint8_t { Spawning = 0, SeekWeapon, MoveToWeapon, Search, Chase, Attack, Dead, Respawn, Count };
+
+struct CommitParams {
+    float minDwell = 0.30f;       // s: a non-urgent state must live this long
+    float attackLeave = 1.50f;    // s: ATTACKING may not fall back to CHASE sooner (P1; P0 used 0.5)
+    float conflictLogGap = 1.0f;  // s: rate-limit conflict logs
+};
+
+class DecisionCommit {
+public:
+    explicit DecisionCommit(const CommitParams& p = CommitParams()) : m_p(p) {}
+
+    void Reset()
+    {
+        m_state = DecisionState::Spawning; m_owner = DecisionOwner::Arbiter;
+        m_stateAt = -1e9f; m_tick = 0; m_tickHadChange = false; m_conflicts = 0; m_lastConflictLog = -1e9f;
+        m_firstOwner = m_secondOwner = DecisionOwner::Arbiter; m_firstState = m_secondState = DecisionState::Spawning;
+        m_tickConflicts = 0;
+    }
+
+    // One decision tick (10 Hz). The first Offer after BeginTick may change state; later ones are conflicts.
+    void BeginTick(uint32_t tick, float now) { m_tick = tick; m_tickHadChange = false; m_tickConflicts = 0; m_now = now; }
+
+    bool Offer(DecisionOwner owner, DecisionState state, float now, bool urgent)
+    {
+        m_now = now;
+        if (state == m_state)
+        {
+            m_owner = owner; // same state, a different writer is harmless
+            return true;
+        }
+        if (m_tickHadChange)
+        {
+            if (!urgent)
+            {
+                ++m_conflicts; ++m_tickConflicts;
+                if (m_tickConflicts == 1) { m_secondOwner = owner; m_secondState = state; }
+                return false; // one state per tick: the first writer wins
+            }
+            // Death/respawn must win over a state that changed earlier in the same tick; count it as a conflict.
+            ++m_conflicts; ++m_tickConflicts;
+            if (m_tickConflicts == 1) { m_secondOwner = owner; m_secondState = state; }
+        }
+        if (!urgent && !CanLeave(now)) return false;
+        if (!urgent && m_state == DecisionState::Attack && now - m_stateAt < m_p.attackLeave) return false;
+        m_firstOwner = m_owner; m_firstState = m_state;
+        m_state = state; m_owner = owner; m_stateAt = now; m_tickHadChange = true;
+        return true;
+    }
+
+    // True when leaving the current state is allowed (dwell elapsed). Urgent callers ignore this.
+    bool CanLeave(float now) const { return (now - m_stateAt) >= m_p.minDwell; }
+
+    DecisionState State() const { return m_state; }
+    DecisionOwner Owner() const { return m_owner; }
+    float StateAge(float now) const { return now - m_stateAt; }
+    int Conflicts() const { return m_conflicts; }
+    int TickConflicts() const { return m_tickConflicts; }
+    bool ChangedThisTick() const { return m_tickHadChange; }
+    DecisionOwner FirstOwner() const { return m_firstOwner; }
+    DecisionOwner SecondOwner() const { return m_secondOwner; }
+    DecisionState FirstState() const { return m_firstState; }
+    DecisionState SecondState() const { return m_secondState; }
+
+    // Rate-limited report: true at most once per conflictLogGap.
+    bool ShouldLogConflict(float now)
+    {
+        if (!m_tickConflicts) return false;
+        if (now - m_lastConflictLog < m_p.conflictLogGap) return false;
+        m_lastConflictLog = now; return true;
+    }
+
+private:
+    CommitParams m_p;
+    DecisionState m_state = DecisionState::Spawning;
+    DecisionOwner m_owner = DecisionOwner::Arbiter;
+    float m_stateAt = 0.f, m_now = 0.f, m_lastConflictLog = -1e9f;
+    uint32_t m_tick = 0;
+    bool m_tickHadChange = false;
+    int m_tickConflicts = 0, m_conflicts = 0;
+    DecisionOwner m_firstOwner = DecisionOwner::Arbiter, m_secondOwner = DecisionOwner::Arbiter;
+    DecisionState m_firstState = DecisionState::Spawning, m_secondState = DecisionState::Spawning;
+};
+
+// Movement-destination hysteresis: keep the previous destination until it is > minMove away or maxAge elapsed.
+// Prevents two writers inside the same state from alternating the destination every tick.
+struct MoveCommit {
+    float minMove = 0.75f;
+    float maxAge = 2.5f;
+    bool Has() const { return m_valid; }
+    bool Valid(float x, float y, float z, float now) const
+    {
+        if (!m_valid) return false;
+        const float dx = x - m_x, dy = y - m_y, dz = z - m_z;
+        return (dx * dx + dy * dy + dz * dz) < minMove * minMove && (now - m_at) < maxAge;
+    }
+    void Get(float& x, float& y, float& z) const { x = m_x; y = m_y; z = m_z; }
+    void Set(float x, float y, float z, float now) { m_x = x; m_y = y; m_z = z; m_at = now; m_valid = true; }
+    void Reset() { m_valid = false; }
+private:
+    float m_x = 0, m_y = 0, m_z = 0, m_at = 0;
+    bool m_valid = false;
+};
+
+} // namespace WarsBots
diff --git a/Tests/BotDecisionCommitTests.cpp b/Tests/BotDecisionCommitTests.cpp
new file mode 100644
index 00000000..68e6fb79
--- /dev/null
+++ b/Tests/BotDecisionCommitTests.cpp
@@ -0,0 +1,97 @@
+// DS-043 P1 tests: one state change per decision serial, dwell, attack band and move commit (engine-free).
+#include "CryGame/Bots/BotDecisionCommit.h"
+#include <cassert>
+#include <cstdio>
+
+using namespace WarsBots;
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { std::printf("FAIL %s:%d %s\n", __FILE__, __LINE__, #cond); ++failures; } } while (0)
+
+int main()
+{
+    {
+        DecisionCommit c; c.Reset(); c.BeginTick(1, 0.0f);
+        CHECK(c.Offer(DecisionOwner::Roam, DecisionState::Search, 0.0f, false));
+        CHECK(!c.Offer(DecisionOwner::Upgrade, DecisionState::MoveToWeapon, 0.0f, false));
+        CHECK(c.TickConflicts() == 1 && c.Conflicts() == 1);
+        CHECK(c.State() == DecisionState::Search);
+        CHECK(c.FirstOwner() == DecisionOwner::Arbiter && c.SecondOwner() == DecisionOwner::Upgrade);
+    }
+    {
+        // Death in the same tick must win over a roam change.
+        DecisionCommit c; c.Reset(); c.BeginTick(1, 0.0f);
+        CHECK(c.Offer(DecisionOwner::Roam, DecisionState::Search, 0.0f, false));
+        CHECK(c.Offer(DecisionOwner::Arbiter, DecisionState::Dead, 0.0f, true));
+        CHECK(c.State() == DecisionState::Dead);
+        CHECK(c.TickConflicts() == 1);
+    }
+    {
+        // Same state from another writer is not a conflict.
+        DecisionCommit c; c.Reset(); c.BeginTick(1, 10.0f);
+        CHECK(c.Offer(DecisionOwner::Roam, DecisionState::Search, 10.0f, false));
+        CHECK(c.Offer(DecisionOwner::Combat, DecisionState::Search, 10.0f, false));
+        CHECK(c.Conflicts() == 0);
+        CHECK(c.Owner() == DecisionOwner::Combat);
+    }
+    {
+        // 0.3 s non-urgent dwell.
+        DecisionCommit c; c.Reset(); c.BeginTick(1, 0.0f);
+        CHECK(c.Offer(DecisionOwner::Roam, DecisionState::Search, 0.0f, false));
+        c.BeginTick(2, 0.1f);
+        CHECK(!c.Offer(DecisionOwner::Combat, DecisionState::Attack, 0.1f, false));
+        c.BeginTick(4, 0.3f);
+        CHECK(c.Offer(DecisionOwner::Combat, DecisionState::Attack, 0.3f, false));
+        CHECK(c.State() == DecisionState::Attack);
+    }
+    {
+        // P1 attack band: 1.5 s before falling back to CHASE.
+        DecisionCommit c; c.Reset(); c.BeginTick(1, 0.0f);
+        CHECK(c.Offer(DecisionOwner::Combat, DecisionState::Attack, 0.0f, true));
+        c.BeginTick(2, 1.4f);
+        CHECK(!c.Offer(DecisionOwner::Combat, DecisionState::Chase, 1.4f, false));
+        c.BeginTick(3, 1.6f);
+        CHECK(c.Offer(DecisionOwner::Combat, DecisionState::Chase, 1.6f, false));
+    }
+    {
+        // 100 Hz input still yields at most ~4 changes in 1 s (0.3 s dwell), and at most one per tick.
+        DecisionCommit c; c.Reset();
+        int changes = 0;
+        DecisionState last = DecisionState::Search;
+        for (int i = 0; i < 100; ++i)
+        {
+            const float t = i * 0.01f;
+            c.BeginTick(uint32_t(i + 1), t);
+            const DecisionState s = (i % 2) ? DecisionState::Search : DecisionState::MoveToWeapon;
+            if (c.Offer(DecisionOwner::Roam, s, t, false) && s != last) { ++changes; last = s; }
+        }
+        CHECK(changes <= 4);
+    }
+    {
+        // Rate-limited conflict log.
+        DecisionCommit c; c.Reset(); c.BeginTick(1, 0.0f);
+        c.Offer(DecisionOwner::Roam, DecisionState::Search, 0.0f, false);
+        CHECK(!c.Offer(DecisionOwner::Upgrade, DecisionState::MoveToWeapon, 0.0f, false));
+        CHECK(c.ShouldLogConflict(0.0f));
+        CHECK(!c.ShouldLogConflict(0.5f));
+        CHECK(c.ShouldLogConflict(1.0f));
+    }
+    {
+        // MoveCommit holds a destination for 0.75 m / 2.5 s and can be read back.
+        MoveCommit m;
+        CHECK(!m.Has());
+        CHECK(!m.Valid(1, 2, 3, 0.0f));
+        m.Set(1, 2, 3, 0.0f);
+        float x = 0, y = 0, z = 0; m.Get(x, y, z);
+        CHECK(x == 1 && y == 2 && z == 3);
+        CHECK(m.Has() && m.Valid(1.2f, 2.0f, 3.0f, 0.5f));
+        CHECK(!m.Valid(2.0f, 2.0f, 3.0f, 0.5f));
+        CHECK(!m.Valid(1.1f, 2.0f, 3.0f, 3.0f));
+        m.Reset();
+        CHECK(!m.Has());
+    }
+
+    if (failures) { std::printf("decision_commit: %d FAILURES\n", failures); return 1; }
+    std::printf("decision_commit: all tests passed\n");
+    return 0;
+}
