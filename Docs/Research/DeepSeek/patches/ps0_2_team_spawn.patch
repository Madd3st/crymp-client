diff --git a/Code/CryGame/Bots/BotTeamPlan.h b/Code/CryGame/Bots/BotTeamPlan.h
new file mode 100644
index 00000000..572a09e6
--- /dev/null
+++ b/Code/CryGame/Bots/BotTeamPlan.h
@@ -0,0 +1,21 @@
+// PS-0 #2: team assignment before the first spawn. In PowerStruggle a bot must have a team before
+// GetSpawnLocationTeam / SetPlayerSpawnGroup / EquipPlayer, otherwise it is a neutral channel-0 actor.
+// Pure logic, no engine types; Tests/BotTeamPlanTests.cpp.
+#pragma once
+
+namespace WarsBots {
+
+// Alternating slot assignment (1-based): odd -> tan (1), even -> black (2).
+inline int TeamForSlot(int slot)
+{
+    return (slot & 1) ? 1 : 2;
+}
+// Balance a new slot by current team sizes; tie goes to the slot's natural team so a fresh 3v3 does not drift.
+inline int TeamForCounts(int slot, int tanCount, int blackCount)
+{
+    if (tanCount < blackCount) return 1;
+    if (blackCount < tanCount) return 2;
+    return TeamForSlot(slot);
+}
+
+} // namespace WarsBots
diff --git a/Tests/BotTeamPlanTests.cpp b/Tests/BotTeamPlanTests.cpp
new file mode 100644
index 00000000..3b3f1f57
--- /dev/null
+++ b/Tests/BotTeamPlanTests.cpp
@@ -0,0 +1,16 @@
+// PS-0 #2 tests: team-before-spawn policy (engine-free).
+#include "CryGame/Bots/BotTeamPlan.h"
+#include <cassert>
+#include <cstdio>
+using namespace WarsBots;
+
+int main()
+{
+    assert(TeamForSlot(1) == 1 && TeamForSlot(2) == 2 && TeamForSlot(3) == 1);
+    assert(TeamForCounts(1, 0, 0) == 1);
+    assert(TeamForCounts(2, 3, 1) == 2);
+    assert(TeamForCounts(3, 1, 3) == 1);
+    assert(TeamForCounts(4, 2, 2) == 2);
+    std::printf("team plan: all tests passed\n");
+    return 0;
+}
