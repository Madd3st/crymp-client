diff --git a/Tests/BotNavMeshWaterTests.cpp b/Tests/BotNavMeshWaterTests.cpp
index d54c90c..edea8a3 100644
--- a/Tests/BotNavMeshWaterTests.cpp
+++ b/Tests/BotNavMeshWaterTests.cpp
@@ -43,5 +43,25 @@ int main()
  float deviation=0;for(size_t i=0;i<path.size();i+=3)deviation=std::max(deviation,std::fabs(path[i+1]+15));
  std::printf("water detour: corners=%zu deviation=%.2f\n",path.size()/3,deviation);
  if(deviation<4.5f){std::puts("water shortcut selected despite expensive area");return 1;}
+ // DS-088: real-core water-start controls on the same synthetic Detour mesh. The raw swimmer feet are 1.5 m below
+ // the water surface (mesh 100); the dry box must not project, the bounded water box must project the water area,
+ // and the water query is water-only (land/no-ref/non-water fails closed, no dry/seabed/stacked fallback).
+ {
+  const float swim[3]={15,-15,98.5f};          // over the water row (x1..x2, z1)
+  const float land[3]={5,-15,100};             // land tile x0, same row
+  const WarsBots::NavQueryBounds water=WarsBots::WaterQueryBounds();
+  float snap[3];
+  if(nav.Project(swim,snap)){std::puts("DS088 raw dry projection unexpectedly found");return 5;}
+  if(!nav.Project(swim,snap,water.side,water.up,water.down,true)){std::puts("DS088 water projection failed");return 5;}
+  if(std::fabs(snap[2]-100.0f)>0.6f){std::puts("DS088 water projection wrong height");return 5;}
+  if(nav.Reachable(swim,land)){std::puts("DS088 dry reachable from swim");return 5;}
+  if(!nav.Reachable(swim,land,2.6f,&water)){std::puts("DS088 water reach failed");return 5;}
+  // The water query is water-only: the land start (non-water area) fails, the dry caller still works.
+  if(nav.Reachable(land,land,2.6f,&water)){std::puts("DS088 water query accepted land");return 5;}
+  if(!nav.Reachable(land,land)){std::puts("DS088 dry land failed");return 5;}
+  // No water ref (outside the mesh): fail closed, never substitute the land/dry.
+  const float hole[3]={-5,-15,98.5f};
+  if(nav.Reachable(hole,land,2.6f,&water)){std::puts("DS088 water query accepted hole");return 5;}
+ }
  std::puts("BotNavMeshWaterTests OK");return 0;
 }
