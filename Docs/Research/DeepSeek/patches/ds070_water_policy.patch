diff --git a/Code/CryGame/Bots/BotWaterPolicy.cpp b/Code/CryGame/Bots/BotWaterPolicy.cpp
new file mode 100644
index 00000000..2ec62cdb
--- /dev/null
+++ b/Code/CryGame/Bots/BotWaterPolicy.cpp
@@ -0,0 +1,30 @@
+#include "PortIncludes.h"
+#include "CryGame/Bots/BotWaterPolicy.h"
+#include "CryGame/Bots/BotConfig.h"
+#include "CryGame/Bots/BotManager.h"
+#include "CryGame/Bots/BotMatch.h"
+#include "CryGame/Actors/Player/Player.h"
+#include "CryGame/Game.h"
+#include "CryGame/GameRules.h"
+
+namespace WarsBots
+{
+BotWaterFacts BotWaterFactsFor(const CPlayer& actor)
+{
+	BotWaterFacts f;
+#if defined(WARSBOTS_EXPERIMENTAL_SPAWNER)
+	f.experimentalBuild = true;
+#endif
+	const CGameRules* rules = g_pGame ? g_pGame->GetGameRules() : nullptr;
+	f.multiplayer = gEnv && gEnv->bMultiplayer;
+	f.powerStruggle = rules && BotMatch::IsPowerStruggle(*rules);
+	f.owned = g_pGame && g_pGame->GetBotManager().Owns(actor.GetEntityId());
+	f.botActor = actor.IsWarsBotActor();
+	f.captureEnabled = BotConfig::Get().psCapture == 1;
+	f.navMeshEnabled = BotConfig::Get().botNavmesh == 1;
+	f.hasNanoSuit = actor.GetNanoSuit() != nullptr;
+	return f;
+}
+
+bool BotWaterAllowedFor(const CPlayer& actor) { return BotWaterAllowed(BotWaterFactsFor(actor)); }
+}
diff --git a/Code/CryGame/Bots/BotWaterPolicy.h b/Code/CryGame/Bots/BotWaterPolicy.h
new file mode 100644
index 00000000..c7d9e90f
--- /dev/null
+++ b/Code/CryGame/Bots/BotWaterPolicy.h
@@ -0,0 +1,32 @@
+// DS-070: the single policy for the owned PowerStruggle bot's native water handling.
+// Every water exception (canMove, SafeStep ground ray, trap watchdog, native oxygen/drowning) must call
+// BotWaterAllowed with these facts, so one false field disables all of them together and OFF/IA/human/unowned
+// actors keep the old "water is impassable" behaviour. Engine-free: Tests/BotWaterPolicyTests.cpp.
+#pragma once
+
+class CPlayer;
+
+namespace WarsBots
+{
+struct BotWaterFacts
+{
+	bool experimentalBuild = false; // built with WARSBOTS_EXPERIMENTAL_SPAWNER
+	bool multiplayer = false;       // gEnv->bMultiplayer
+	bool powerStruggle = false;     // BotMatch::IsPowerStruggle
+	bool owned = false;             // BotManager::Owns on this server
+	bool botActor = false;          // CPlayer::IsWarsBotActor (our channelId-0 actor)
+	bool captureEnabled = false;    // BotConfig::psCapture == 1
+	bool navMeshEnabled = false;    // BotConfig::botNavmesh == 1
+	bool hasNanoSuit = false;       // the native oxygen path dereferences the suit
+};
+
+inline bool BotWaterAllowed(const BotWaterFacts& f)
+{
+	return f.experimentalBuild && f.multiplayer && f.powerStruggle && f.owned && f.botActor &&
+		f.captureEnabled && f.navMeshEnabled && f.hasNanoSuit;
+}
+
+// Engine-side facts for one actor. Defined in BotWaterPolicy.cpp; the pure truth table above links without it.
+BotWaterFacts BotWaterFactsFor(const CPlayer& actor);
+bool BotWaterAllowedFor(const CPlayer& actor);
+}
diff --git a/Tests/BotWaterPolicyTests.cpp b/Tests/BotWaterPolicyTests.cpp
new file mode 100644
index 00000000..f8643950
--- /dev/null
+++ b/Tests/BotWaterPolicyTests.cpp
@@ -0,0 +1,46 @@
+// DS-070: one gated water policy for the owned PowerStruggle bot (engine-free).
+// The same truth table gates canMove, the SafeStep ground ray, trap recovery and the native oxygen path, so an OFF
+// build, Instant Action, a human or an unowned actor can never get any of the exceptions.
+#include "CryGame/Bots/BotWaterPolicy.h"
+#include <cassert>
+#include <cstdio>
+
+using namespace WarsBots;
+
+static BotWaterFacts AllOn()
+{
+	BotWaterFacts f;
+	f.experimentalBuild = true;
+	f.multiplayer = true;
+	f.powerStruggle = true;
+	f.owned = true;
+	f.botActor = true;
+	f.captureEnabled = true;
+	f.navMeshEnabled = true;
+	f.hasNanoSuit = true;
+	return f;
+}
+
+int main()
+{
+	// Positive: the owned PowerStruggle bot on a multiplayer server with both existing switches on.
+	assert(BotWaterAllowed(AllOn()));
+
+	// Every field is required: flipping any one off disables all water exceptions together.
+	{
+		BotWaterFacts f = AllOn(); f.experimentalBuild = false; assert(!BotWaterAllowed(f)); // OFF build
+		f = AllOn(); f.multiplayer = false;      assert(!BotWaterAllowed(f));              // Instant Action
+		f = AllOn(); f.powerStruggle = false;    assert(!BotWaterAllowed(f));              // non-PS mode
+		f = AllOn(); f.owned = false;            assert(!BotWaterAllowed(f));              // replica/unowned
+		f = AllOn(); f.botActor = false;         assert(!BotWaterAllowed(f));              // human actor
+		f = AllOn(); f.captureEnabled = false;   assert(!BotWaterAllowed(f));              // wb_ps_capture 0
+		f = AllOn(); f.navMeshEnabled = false;   assert(!BotWaterAllowed(f));              // wb_bot_navmesh 0
+		f = AllOn(); f.hasNanoSuit = false;      assert(!BotWaterAllowed(f));              // oxygen path needs a suit
+	}
+
+	// The default struct (all false) can never enable water.
+	{ BotWaterFacts f; assert(!BotWaterAllowed(f)); }
+
+	std::puts("BotWaterPolicyTests OK");
+	return 0;
+}
