 	float now = 0.f;
@@ -56,8 +57,27 @@ struct LinkParams {
 	float strengthEnergy = 90.f;       // DS-033: links started at 10-57 energy landed short
 	float dropAirMin = 0.15f;          // m below a that counts as "left the edge" for a drop
 	float maxStrengthRise = 3.72f;     // DS-046: native Strength jump rise ~3.62 m; a +4.30 m link cannot land
+	// DS-083: horizontal take-off speeds used to choose the gait from the link geometry (baker vh = 4.5, player sprint).
+	float runSpeed = 4.5f;
+	float sprintSpeed = 6.75f;
 };
 
+// DS-083: native Strength arc geometry (apex 3.62 m -> v0 = sqrt(2*g*apex), descending branch at the target rise).
+// Horizontal speed that reaches the link's own end at that height. Short/high links need run; long flat links need
+// sprint. Geometry only: no map data and no per-link field.
+inline float StrengthNeededSpeed(const JVec& a, const JVec& b)
+{
+	const float g = 9.81f;
+	const float v0 = std::sqrt(2.f * g * 3.62f);
+	const float dz = b.z - a.z;
+	const float disc = v0 * v0 - 2.f * g * dz;
+	if (disc <= 0.f) return 1e9f;
+	const float t = (v0 + std::sqrt(disc)) / g;
+	const float dx = b.x - a.x, dy = b.y - a.y;
+	const float dist = std::sqrt(dx * dx + dy * dy);
+	return t > 1e-3f ? dist / t : 1e9f;
+}
+
 class BotJumpLink {
 public:
 	explicit BotJumpLink(const LinkParams& p = LinkParams()) : m_p(p) {}
@@ -66,6 +86,15 @@ public:
 	LinkPhase Phase() const { return m_phase; }
 	LinkMove Move() const { return m_move; }
 	void Reset() { m_phase = LinkPhase::Idle; }
+	// DS-083: choose the take-off gait from the link geometry instead of forcing sprint in Act.
+	LinkGait TakeoffGait() const
+	{
+		return (m_move == LinkMove::Strength && StrengthNeededSpeed(m_a, m_b) > m_p.runSpeed) ? LinkGait::Sprint : LinkGait::Run;
+	}
+	bool SpeedFeasible() const
+	{
+		return m_move != LinkMove::Strength || StrengthNeededSpeed(m_a, m_b) <= m_p.sprintSpeed;
+	}
 
 	void Start(float now, LinkMove move, const JVec& a, const JVec& b)
 	{
