@@ -21,6 +21,7 @@ enum class LinkPhase { Idle = 0, Approach, Prepare, RunUp, Act, Air, Done, Faile
 enum class LinkMove { Drop = 0, Jump, Strength };
 enum class LinkJumpRequest { None = 0, Normal, Strength };
