+	if (item.equip) then flag=bor(flag, self.BUY_EQUIPMENT); end;
+	if (item.proto) then flag=bor(flag, self.BUY_PROTOTYPE); end;
+	if (item.vehicle) then flag=bor(flag, self.BUY_VEHICLE); end;
