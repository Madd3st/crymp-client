+function PowerStruggle.Client:ClBuyError(itemName)
+	HUD.OnItemBought(false, itemName);
+end
+
+----------------------------------------------------------------------------------------------------
+function PowerStruggle.Client:ClBuyOk(itemName)
+	HUD.OnItemBought(true, itemName);
+end
