+static bool PointInTri2D(float px, float pz, const float* a, const float* b, const float* c)
+{
+	auto cross = [](float ax, float az, float bx, float bz, float px, float pz) { return (bx - ax) * (pz - az) - (bz - az) * (px - ax); };
+	const float d1 = cross(a[0], a[2], b[0], b[2], px, pz);
+	const float d2 = cross(b[0], b[2], c[0], c[2], px, pz);
+	const float d3 = cross(c[0], c[2], a[0], a[2], px, pz);
+	const bool neg = d1 < 0 || d2 < 0 || d3 < 0, pos = d1 > 0 || d2 > 0 || d3 > 0;
+	return !(neg && pos);
+}
