diff --git a/Code/CryGame/Bots/BotClientSend.h b/Code/CryGame/Bots/BotClientSend.h
new file mode 100644
index 00000000..7e90bd41
--- /dev/null
+++ b/Code/CryGame/Bots/BotClientSend.h
@@ -0,0 +1,12 @@
+// DS-051: per-client RMIs are only for actors with a real client connection.
+// A bot has no client, but its entity has channelId 0 like the listen host, so the
+// decision must use bot identity, never the channel id. Engine-free; tested in
+// Tests/BotAuditFixesTests.cpp.
+#pragma once
+
+namespace WarsBots {
+inline bool PerClientSendAllowed(bool isBot)
+{
+    return !isBot;
+}
+} // namespace WarsBots
