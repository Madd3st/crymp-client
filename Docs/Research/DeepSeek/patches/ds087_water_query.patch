diff --git a/Code/CryGame/Bots/BotWaterQueryPolicy.h b/Code/CryGame/Bots/BotWaterQueryPolicy.h
new file mode 100644
index 0000000..e43aceb
--- /dev/null
+++ b/Code/CryGame/Bots/BotWaterQueryPolicy.h
@@ -0,0 +1,28 @@
+// DS-087: bounded query bounds for the navmesh start of a path/reachability query.
+//
+// A native swimmer's feet sit 1.5-1.8 m below the baked water surface; the dry-floor query box only searches
+// 1 m up and therefore cannot project the water surface. This policy returns the water box only for a native
+// water movement (ShouldSwim + BotWaterAllowed) whose projected polygon is the baked water area; the NavMeshCore
+// still verifies the polygon area and falls back to the dry box. Dry/submarine stacked floors always use the
+// default box: no global up-widening.
+#pragma once
+#include "CryGame/Bots/BotNavMeshCore.h"
+
+namespace WarsBots
+{
+inline NavQueryBounds DryQueryBounds()
+{
+	return NavQueryBounds{1.5f, 1.0f, 3.0f};
+}
+
+inline NavQueryBounds WaterQueryBounds()
+{
+	// up 2.0 covers the measured 1.5-1.8 m feet-to-surface offset; down 0.2 avoids selecting the submerged floor.
+	return NavQueryBounds{1.5f, 2.0f, 0.2f};
+}
+
+inline NavQueryBounds QueryBoundsFor(bool waterMovement, bool waterSurfaceValid)
+{
+	return (waterMovement && waterSurfaceValid) ? WaterQueryBounds() : DryQueryBounds();
+}
+}
diff --git a/Tests/BotWaterQueryPolicyTests.cpp b/Tests/BotWaterQueryPolicyTests.cpp
new file mode 100644
index 0000000..77b151a
--- /dev/null
+++ b/Tests/BotWaterQueryPolicyTests.cpp
@@ -0,0 +1,30 @@
+// DS-087 engine-free policy: the dry default must never be widened; the water box is bounded and only used for
+// the native water movement with a validated baked water surface.
+#include "CryGame/Bots/BotWaterQueryPolicy.h"
+#include <cassert>
+#include <cstdio>
+
+using namespace WarsBots;
+
+int main()
+{
+	const NavQueryBounds dry = DryQueryBounds();
+	assert(dry.side == 1.5f && dry.up == 1.0f && dry.down == 3.0f);
+
+	const NavQueryBounds water = WaterQueryBounds();
+	assert(water.side == 1.5f);
+	assert(water.up >= 1.8f && water.up <= 2.0f);   // covers the measured 1.5-1.8 m feet-to-surface offset
+	assert(water.down <= 0.5f);                     // never reaches a submerged floor in the same box
+	assert(water.down < dry.down && water.up > dry.up);
+
+	// Dry, no native water, invalid surface: always the dry box (no global up-widening).
+	assert(QueryBoundsFor(false, false).up == 1.0f);
+	assert(QueryBoundsFor(false, true).up == 1.0f);
+	assert(QueryBoundsFor(true, false).up == 1.0f);
+	// Native water movement + validated baked water surface: the bounded water box.
+	assert(QueryBoundsFor(true, true).up == 2.0f);
+	assert(QueryBoundsFor(true, true).down == 0.2f);
+
+	std::puts("BotWaterQueryPolicyTests OK");
+	return 0;
+}
