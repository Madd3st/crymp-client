diff --git a/Code/CryGame/Actors/Player/Player.cpp b/Code/CryGame/Actors/Player/Player.cpp
index 469a6df2..4f71a22d 100644
--- a/Code/CryGame/Actors/Player/Player.cpp
+++ b/Code/CryGame/Actors/Player/Player.cpp
@@ -7332,6 +7332,19 @@ void CPlayer::LeaveLadder(ELadderActionType reason)
 
 	if (reason == eLAT_ExitTop)
 	{
+#if defined(WARSBOTS_EXPERIMENTAL_SPAWNER)
+		// DS-122: record the graph state at the exact moment the stock one-shot exit signal is issued. This decides
+		// whether the owned bot was still in the ladder state (the signal can select the installed off-top state)
+		// or had already fallen back to a locomotion state. No graph input is changed here.
+		if (gEnv && gEnv->bServer && g_pGame && IsWarsBotActor() && g_pGame->GetBotManager().Owns(GetEntityId()) &&
+			WarsBots::BotConfig::Get().ladder==1 && m_pAnimatedCharacter)
+		{
+			IAnimationGraphState* graph=m_pAnimatedCharacter->GetAnimationGraphState();
+			const char* output=graph ? graph->QueryOutput("OnLadder") : NULL;
+			WB_LOG(2,"[WarsBots] LADDER EXIT SIGNAL actor=%u state=%s output=%s.",
+				GetEntityId(),graph&&graph->GetCurrentStateName()?graph->GetCurrentStateName():"<none>",output?output:"<none>");
+		}
+#endif
 		m_stats.isExitingLadder = true;
 		UpdateLadderAnimation(CPlayer::eLS_ExitTop, eLDIR_Up);
 	}
