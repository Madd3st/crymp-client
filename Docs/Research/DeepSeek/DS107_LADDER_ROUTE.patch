+// ---------------------------------------------------------------------------------------------- C154/DS-107 ladder
+// Starts at a real NavLinkLadder corner. The pure policy owns approach/grab/climb/exit; the native CPlayerMovement
+// owns the actual ladder motion and its collision/ray/animation exit. No SetPos/SetWorldTM and no height-only detach.
+void BotBrain::ApplyLadderExecutor(CPlayer& actor)
+{
+	if (m_ladder.Active()) return;
+	NavMeshCore* mesh=CurrentNavMesh();
+	if (!mesh || !m_meshPathActive || !m_intent.move || m_intent.combat==BotCombatIntent::Fire) return;
+	const NavPathLink* l=LinkAtCorner(m_pathIndex);
+	if (!l || l->kind!=NavLinkLadder) return;
+	const Vec3 a(l->a[0],l->a[1],l->a[2]);
+	const Vec3 feet=m_blackboard.position;
+	if ((a-feet).GetLengthSquared2D()>4.0f || fabs_tpl(a.z-feet.z)>2.0f) return;
+	m_ladderNow=*l;
+	m_ladder.Start(m_now,LVec{l->a[0],l->a[1],l->a[2]},LVec{l->b[0],l->b[1],l->b[2]});
+	WB_LOG(2,"[WarsBots] #%d LADDER start a=(%.2f,%.2f,%.2f) b=(%.2f,%.2f,%.2f) actor=%u.",m_number,
+		l->a[0],l->a[1],l->a[2],l->b[0],l->b[1],l->b[2],actor.GetEntityId());
+}
+
+void BotBrain::UpdateLadder(BotInstance& bot, CPlayer& actor, float dt)
+{
+	SPlayerStats* stats=actor.GetPlayerStats();
+	const Vec3 feet=actor.GetEntity()->GetWorldPos();
+	const Vec3 center(m_ladderNow.a[0],m_ladderNow.a[1],m_ladderNow.a[2]+1.2f);
+	m_locomotion.Look(actor,center); // make the native IsLadderUsable ray see mat_ladder
+	LadderInput in;
+	in.now=m_now; in.feet=LVec{feet.x,feet.y,feet.z};
+	in.onLadder=stats && stats->isOnLadder.Value();
+	in.exiting=stats && stats->isExitingLadder;
+	in.canGrab=actor.IsLadderUsable();
+	if (in.canGrab && stats)
+		m_ladder.SetNative(LVec{stats->ladderBottom.x,stats->ladderBottom.y,stats->ladderBottom.z},
+			LVec{stats->ladderTop.x,stats->ladderTop.y,stats->ladderTop.z},
+			LVec{stats->ladderOrientation.x,stats->ladderOrientation.y,stats->ladderOrientation.z});
+	const LadderOutput o=m_ladder.Update(in);
+	if (o.grab) actor.RequestGrabOnLadder(CPlayer::eLAT_Use);
+	if (o.requestExit) actor.RequestLeaveLadder(CPlayer::eLAT_ExitTop);
+	NavMeshCore* mesh=CurrentNavMesh();
+	if (o.phase==LadderPhase::Done)
+	{
+		WB_LOG(2,"[WarsBots] #%d LADDER done nativeOn=%d exiting=%d pos=(%.2f,%.2f,%.2f) actor=%u.",m_number,
+			in.onLadder?1:0,in.exiting?1:0,feet.x,feet.y,feet.z,actor.GetEntityId());
+		const size_t next=size_t(m_ladderNow.corner)+1;
+		m_cornerFor=size_t(-1);
+		m_pathIndex=m_path.empty()?0:(next<m_path.size()?next:m_path.size()-1);
+		m_ladder.Reset();
+		return;
+	}
+	if (o.phase==LadderPhase::Failed)
+	{
+		static const char* const why[]={"none","timeout","no_grab","lost","blocked_top","wrong_floor"};
+		WB_LOG(1,"[WarsBots] #%d LADDER failed reason=%s nativeOn=%d exiting=%d pos=(%.2f,%.2f,%.2f) actor=%u.",m_number,
+			why[int(o.fail)],in.onLadder?1:0,in.exiting?1:0,feet.x,feet.y,feet.z,actor.GetEntityId());
+		if (mesh && mesh->NoteLinkFailure(m_ladderNow.ref)) mesh->BanLink(m_ladderNow.ref);
+		m_ladder.Reset(); m_path.clear(); m_pathLinks.clear(); m_pathIndex=0; m_cornerFor=size_t(-1);
+		m_nextRepath=m_minRepath=0;
+		return;
+	}
+	m_intent=BotIntent();
+	WBI(move,true);
+	WBI(destination,Vec3(o.moveTo.x,o.moveTo.y,o.moveTo.z));
+	WBI(aim,center);
+	WBI(gait,BotGait::Walk);
+	WBI(suitMode,NANOMODE_DEFENSE);
+	m_intent.combat=BotCombatIntent::None; m_intent.jump=BotJump::None; m_intent.linkJump=false;
+	m_intent.meshPath=false; m_intent.arrive=0.5f;
+	m_combat.StopFire();
+	m_locomotion.ExecuteLadder(actor,m_intent.destination,m_intent.aim,dt);
+	if (m_verbose) WB_LOG(2,"[WarsBots] #%d LADDER phase=%d grab=%d exit=%d climb=%d nativeOn=%d exiting=%d pos=(%.2f,%.2f,%.2f) actor=%u.",
+		m_number,int(o.phase),o.grab?1:0,o.requestExit?1:0,o.climbing?1:0,in.onLadder?1:0,in.exiting?1:0,
+		feet.x,feet.y,feet.z,actor.GetEntityId());
+}
