diff --git a/Code/CryGame/Bots/BotLadder.h b/Code/CryGame/Bots/BotLadder.h
new file mode 100644
index 00000000..47c99c86
--- /dev/null
+++ b/Code/CryGame/Bots/BotLadder.h
@@ -0,0 +1,159 @@
+// C154 / DS-107: bounded native ladder policy (wb_bot_ladder, default OFF).
+// The policy is engine-free: it only decides approach / grab / climb / native-exit phases and the move target.
+// The engine adapter (BotBrain) performs IsLadderUsable/RequestGrabOnLadder/RequestLeaveLadder and lets the stock
+// CPlayerMovement collision/ray/animation checks own the exit. No SetPos/SetWorldTM, no height-only detach:
+// success requires native !onLadder && !exiting plus a physical post-exit floor/position.
+#pragma once
+#include <cmath>
+
+namespace WarsBots {
+
+struct LVec { float x = 0, y = 0, z = 0; };
+
+enum class LadderPhase { Idle = 0, Approach, Grab, Climb, Exit, Done, Failed };
+enum class LadderFail { None = 0, Timeout, NoGrab, Lost, BlockedTop, WrongFloor };
+
+struct LadderInput {
+	float now = 0.f;
+	LVec feet;
+	bool onLadder = false;      // native m_stats.isOnLadder
+	bool exiting = false;       // native m_stats.isExitingLadder
+	bool canGrab = false;       // native IsLadderUsable() (mat_ladder ray/geometry)
+};
+
+struct LadderOutput {
+	LadderPhase phase = LadderPhase::Idle;
+	LVec moveTo;
+	bool grab = false;          // adapter may call RequestGrabOnLadder(eLAT_Use)
+	bool requestExit = false;   // adapter may call RequestLeaveLadder(eLAT_ExitTop)
+	bool climbing = false;
+	LadderFail fail = LadderFail::None;
+};
+
+struct LadderParams {
+	float approachRadius = 1.2f;
+	float grabTime = 1.0f;
+	float total = 15.f;
+	float topEps = 2.5f;        // native ladderTop band (LADDER_TOP_DISTANCE 2.41 + margin; human exit 99.54)
+	float exitTime = 1.5f;      // native collision/animation completion window
+	float floorDz = 1.0f;       // post-exit physical floor tolerance
+	float floorDist = 2.5f;
+};
+
+class BotLadder {
+public:
+	explicit BotLadder(const LadderParams& p = LadderParams()) : m_p(p) {}
+	void Reset()
+	{
+		m_phase = LadderPhase::Idle; m_fail = LadderFail::None;
+		m_start = m_phaseAt = 0.f; m_a = m_b = m_bottom = m_top = m_into = LVec();
+	}
+	void Start(float now, const LVec& a, const LVec& b)
+	{
+		m_a = a; m_b = b; m_bottom = a; m_top = b;
+		m_into = Horiz(b.x - a.x, b.y - a.y);
+		m_start = m_phaseAt = now; m_phase = LadderPhase::Approach;
+		m_fail = LadderFail::None;
+	}
+	// Called after IsLadderUsable() set the native ladder stats. orientation points from the ladder to the player.
+	void SetNative(const LVec& bottom, const LVec& top, const LVec& orientation)
+	{
+		m_bottom = bottom; m_top = top;
+		m_into = Horiz(-orientation.x, -orientation.y);
+	}
+	bool Active() const { return m_phase != LadderPhase::Idle && m_phase != LadderPhase::Done && m_phase != LadderPhase::Failed; }
+	LadderPhase Phase() const { return m_phase; }
+	LadderFail Fail() const { return m_fail; }
+	const LVec& Base() const { return m_a; }
+	const LVec& Top() const { return m_b; }
+	const LVec& Into() const { return m_into; }
+
+	LadderOutput Update(const LadderInput& in)
+	{
+		LadderOutput o;
+		for (int i = 0; i < 3; ++i)
+		{
+			const LadderPhase before = m_phase;
+			o = Step(in);
+			if (m_phase == before || (m_phase != LadderPhase::Grab && m_phase != LadderPhase::Climb && m_phase != LadderPhase::Exit))
+				break;
+		}
+		return o;
+	}
+
+private:
+	LadderOutput Step(const LadderInput& in)
+	{
+		LadderOutput o;
+		o.phase = m_phase;
+		o.moveTo = m_b;
+		if (!Active()) return o;
+		if (in.now - m_start > m_p.total) return Fail(o, LadderFail::Timeout);
+		switch (m_phase)
+		{
+		case LadderPhase::Approach:
+			o.moveTo = m_a;
+			if (Dist2D(in.feet, m_a) <= m_p.approachRadius) Enter(LadderPhase::Grab, in.now);
+			break;
+		case LadderPhase::Grab:
+			o.moveTo = m_a;
+			o.grab = in.canGrab;
+			if (in.onLadder) Enter(LadderPhase::Climb, in.now);
+			else if (in.now - m_phaseAt > m_p.grabTime) return Fail(o, LadderFail::NoGrab);
+			break;
+		case LadderPhase::Climb:
+			o.climbing = true;
+			o.moveTo = LVec{ in.feet.x + m_into.x * 2.f, in.feet.y + m_into.y * 2.f, in.feet.z };
+			if (!in.onLadder)
+			{
+				// A native detach below the top band is a lost climb, never a success.
+				if (in.feet.z < m_top.z - m_p.topEps) return Fail(o, LadderFail::Lost);
+				Enter(LadderPhase::Exit, in.now);
+			}
+			else if (in.feet.z >= m_top.z - m_p.topEps) Enter(LadderPhase::Exit, in.now);
+			break;
+		case LadderPhase::Exit:
+			o.moveTo = m_b;
+			o.requestExit = true;
+			if (!in.onLadder && !in.exiting)
+			{
+				if (in.feet.z >= m_b.z - m_p.floorDz && Dist2D(in.feet, m_b) <= m_p.floorDist)
+				{
+					m_phase = LadderPhase::Done; o.phase = m_phase; return o;
+				}
+				return Fail(o, LadderFail::WrongFloor);
+			}
+			if (in.now - m_phaseAt > m_p.exitTime) return Fail(o, LadderFail::BlockedTop);
+			break;
+		default: break;
+		}
+		o.phase = m_phase;
+		return o;
+	}
+
+	static LVec Horiz(float x, float y)
+	{
+		const float l = std::sqrt(x * x + y * y);
+		return l > 1e-4f ? LVec{ x / l, y / l, 0.f } : LVec{ 0.f, 1.f, 0.f };
+	}
+	static float Dist2D(const LVec& a, const LVec& b)
+	{
+		const float dx = a.x - b.x, dy = a.y - b.y;
+		return std::sqrt(dx * dx + dy * dy);
+	}
+	void Enter(LadderPhase p, float now) { m_phase = p; m_phaseAt = now; }
+	LadderOutput Fail(LadderOutput o, LadderFail why)
+	{
+		m_phase = LadderPhase::Failed; m_fail = why;
+		o.phase = m_phase; o.fail = why; o.grab = false; o.requestExit = false; o.climbing = false;
+		return o;
+	}
+
+	LadderParams m_p;
+	LadderPhase m_phase = LadderPhase::Idle;
+	LadderFail m_fail = LadderFail::None;
+	LVec m_a, m_b, m_bottom, m_top, m_into;
+	float m_start = 0.f, m_phaseAt = 0.f;
+};
+
+} // namespace WarsBots
