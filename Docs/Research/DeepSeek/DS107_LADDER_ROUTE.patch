diff --git a/Tests/BotLadderTests.cpp b/Tests/BotLadderTests.cpp
new file mode 100644
index 00000000..229dabed
--- /dev/null
+++ b/Tests/BotLadderTests.cpp
@@ -0,0 +1,70 @@
+#include "CryGame/Bots/BotLadder.h"
+#include <cassert>
+#include <cstdio>
+using namespace WarsBots;
+
+static LadderInput At(float t, float x, float y, float z, bool onLadder = false, bool exiting = false, bool canGrab = false)
+{
+	LadderInput in; in.now = t; in.feet = { x, y, z }; in.onLadder = onLadder; in.exiting = exiting; in.canGrab = canGrab;
+	return in;
+}
+
+int main()
+{
+	const LVec a{ 0, 0, 10 }, b{ 1, 0, 20 };
+	// 1. Approach -> Grab; a missing mat_ladder match never requests a grab and fails after the window.
+	{
+		BotLadder L; L.Start(0, a, b);
+		LadderOutput o = L.Update(At(0, 0, 3, 10)); assert(o.phase == LadderPhase::Approach && o.moveTo.z == 10.f);
+		o = L.Update(At(0.2f, 0, 0.5f, 10)); assert(o.phase == LadderPhase::Grab && !o.grab);
+		o = L.Update(At(1.4f, 0, 0.5f, 10)); assert(o.fail == LadderFail::NoGrab && !L.Active());
+	}
+	// 2. Grab with a real mat_ladder match -> native onLadder -> Climb; move target goes into the ladder.
+	{
+		BotLadder L; L.Start(0, a, b); L.SetNative(a, b, LVec{ 0, 1, 0 }); // player on +y, into = -y
+		L.Update(At(0, 0, 0.5f, 10));
+		LadderOutput o = L.Update(At(0.2f, 0, 0.5f, 10, false, false, true));
+		assert(o.phase == LadderPhase::Grab && o.grab);
+		o = L.Update(At(0.3f, 0, 0.5f, 10, true, false, true));
+		assert(o.phase == LadderPhase::Climb && o.climbing);
+		assert(o.moveTo.y < -1.f && o.moveTo.z == 10.f); // horizontal into -y, no injected z
+	}
+	// 3. Native top band -> eLAT_ExitTop request; pending native exit is not success.
+	{
+		BotLadder L; L.Start(0, a, b); L.SetNative(a, b, LVec{ 0, 1, 0 });
+		L.Update(At(0, 0, 0.5f, 10)); L.Update(At(0.1f, 0, 0.5f, 10, true));
+		LadderOutput o = L.Update(At(8.0f, 0, 0.5f, 19.5f, true));
+		assert(o.phase == LadderPhase::Exit && o.requestExit);
+		o = L.Update(At(8.2f, 0, 0.5f, 19.5f, true, true));
+		assert(o.phase == LadderPhase::Exit && o.requestExit && L.Active());
+	}
+	// 4. Native exit completes on the physical deck -> Done; wrong floor or blocked top never succeeds.
+	{
+		BotLadder L; L.Start(0, a, b); L.SetNative(a, b, LVec{ 0, 1, 0 });
+		L.Update(At(0, 0, 0.5f, 10)); L.Update(At(0.1f, 0, 0.5f, 10, true));
+		L.Update(At(8.0f, 0, 0.5f, 19.5f, true));
+		LadderOutput o = L.Update(At(8.2f, 0.2f, 0.1f, 19.5f, false, false));
+		assert(o.phase == LadderPhase::Done && !L.Active());
+
+		BotLadder M; M.Start(0, a, b); M.SetNative(a, b, LVec{ 0, 1, 0 });
+		M.Update(At(0, 0, 0.5f, 10)); M.Update(At(0.1f, 0, 0.5f, 10, true));
+		M.Update(At(8.0f, 0, 0.5f, 19.5f, true));
+		o = M.Update(At(8.2f, 5, 5, 5, false, false)); assert(o.fail == LadderFail::WrongFloor);
+
+		BotLadder N; N.Start(0, a, b); N.SetNative(a, b, LVec{ 0, 1, 0 });
+		N.Update(At(0, 0, 0.5f, 10)); N.Update(At(0.1f, 0, 0.5f, 10, true));
+		N.Update(At(8.0f, 0, 0.5f, 19.5f, true));
+		o = N.Update(At(9.6f, 0, 0.5f, 19.5f, true, true)); assert(o.fail == LadderFail::BlockedTop);
+	}
+	// 5. Detach before the top without ever being on the ladder is Lost; total timeout is Timeout; reset is Idle.
+	{
+		BotLadder L; L.Start(0, a, b); L.SetNative(a, b, LVec{ 0, 1, 0 });
+		L.Update(At(0, 0, 0.5f, 10)); L.Update(At(0.1f, 0, 0.5f, 10, true));
+		LadderOutput o = L.Update(At(0.2f, 0, 0.5f, 10, false)); assert(o.fail == LadderFail::Lost);
+
+		BotLadder M; M.Start(0, a, b); o = M.Update(At(16.1f, 0, 3, 10)); assert(o.fail == LadderFail::Timeout);
+		M.Reset(); assert(!M.Active() && M.Phase() == LadderPhase::Idle);
+	}
+	std::printf("BotLadder tests PASS\n");
+	return 0;
+}
